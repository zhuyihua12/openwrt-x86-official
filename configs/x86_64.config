CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 镜像输出格式：squashfs (combined-efi) + vmdk
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_VMDK_IMAGES=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_CONSOLE=y
CONFIG_GRUB_SERIAL=y

# 关闭其他 rootfs 格式
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set

# 核心策略：关闭 IPv6 (适合纯 IPv4 环境)
CONFIG_IPV6=n
CONFIG_KERNEL_IPV6=n

# 防火墙：nftables FW4
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# ---------- LuCI Web 界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-network=y

# ---------- 全中文支持 ----------
# LuCI 核心中文翻译
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 各管理模块中文翻译
CONFIG_PACKAGE_luci-i18n-admin-full-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
CONFIG_PACKAGE_luci-i18n-status-zh-cn=y
CONFIG_PACKAGE_luci-i18n-network-zh-cn=y

# ---------- DNS 服务 ----------
# 使用 dnsmasq-full 替换默认 dnsmasq（解决 OpenClash 冲突）
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ---------- 网络代理 ----------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y

# ---------- 网络工具 ----------
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ---------- 系统服务 ----------
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_vsftpd=y
CONFIG_PACKAGE_luci-i18n-vsftpd-zh-cn=y

# ---------- 实用工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
