#!/bin/sh
# 单网口旁路由首启配置：
#   - 唯一网口(eth0/br-lan)作为 DHCP 客户端，从主路由自动获取 IPv4 地址/网关/DNS
#   - 同口 DHCPv6 客户端，获取 IPv6 地址/前缀/DNS
#   - 本机不提供任何 DHCP/RA/DHCPv6/NDP 服务（由主路由负责）
#   - dnsmasq 仅作为 DNS 服务器（-> mosdns 分流），OpenClash 透明代理照常工作

# ============ 网络：lan 改为 DHCP 客户端，删除 wan/wan6 ============
uci set network.lan.proto='dhcp'
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.gateway
uci -q delete network.lan.ip6assign
uci set network.lan.peerdns='1'
uci -q delete network.wan
uci -q delete network.wan6

# 同口 IPv6 客户端（向主路由拿 v6 地址/前缀/DNS）
uci -q delete network.lan6
uci set network.lan6='interface'
uci set network.lan6.proto='dhcpv6'
uci set network.lan6.device='@lan'
uci set network.lan6.peerdns='1'
uci commit network

# ============ 防火墙：删除 wan 区；lan 区纳入 lan6 ============
i=0
while uci -q get firewall.@zone[$i] >/dev/null 2>&1; do
	nets=$(uci -q get firewall.@zone[$i].network)
	case " $nets " in
	*" wan "*|*" wan6 "*)
		uci delete firewall.@zone[$i]
		i=0
		continue
		;;
	esac
	i=$((i+1))
done
# lan 区加入 lan6 逻辑接口
i=0
while uci -q get firewall.@zone[$i] >/dev/null 2>&1; do
	nets=$(uci -q get firewall.@zone[$i].network)
	case " $nets " in
	*" lan "*)
		case " $nets " in
		*" lan6 "*) ;;
		*) uci add_list firewall.@zone[$i].network='lan6' ;;
		esac
		;;
	esac
	i=$((i+1))
done
uci commit firewall

# ============ 关闭本机全部 DHCP 服务（主路由负责） ============
# ignore=1 即 LuCI 的"忽略此接口"，dhcpv4 才真正不再提供 DHCP
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'
uci commit dhcp

# ============ dnsmasq：保留 DNS 服务角色，全部查询交给 mosdns ============
# 端口 5335 是 luci-app-mosdns 面板的监听端口（面板会自行把 dnsmasq
# 转发到这里，此处显式设置保证首启时序确定）
uci set dhcp.@dnsmasq[0].noresolv='1'
uci -q del_list dhcp.@dnsmasq[0].server='127.0.0.1#5335'
uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5335'
uci commit dhcp

# ============ mosdns：走面板原生 UCI 配置（不要对抗面板模板）============
# 教训：面板 init 会从 UCI 重新生成 /var/etc/mosdns.json 并把 configfile
# 改回模板产物；手写 yaml 指哪打哪的路线走不通，分流逻辑必须用面板 UCI 键表达：
#   remote_dns=127.0.0.1:7874 -> 国外/未命中域名一律问 mihomo（OC 未启动则
#   SERVFAIL，宁可不可达不可泄漏）；国内域名面板默认走 119.29/223.5 直连。
uci set mosdns.config.enabled='1'
uci set mosdns.config.remote_dns='127.0.0.1:7874'
uci commit mosdns
# DNS 重写：time.android.com -> 203.107.6.88（面板 hosts 规则文件，
# 由 uci-defaults 写入避免与包自带空文件的 overlay 归属冲突）
echo "time.android.com 203.107.6.88" > /etc/mosdns/rule/hosts.txt

# ============ OpenClash 预置（导入节点 -> 选节点 -> 保存应用 即可用） ============
uci set openclash.config.enable='1'
# LAN DNS 走 dnsmasq->mosdns 分流，不用 OpenClash 的全量 53 劫持（避免绕过 mosdns）
uci set openclash.config.enable_redirect_dns='0'
# IPv6 下代理域名统一不发 AAAA（Fake-IP v4 栈），防 IPv6 侧泄漏
uci set openclash.config.filter_aaaa_dns='1'
uci set openclash.config.ipv6_enable='1'
# 单臂旁路由：路由器自身流量也走代理，保证 mosdns/mihomo 出境路径干净
uci set openclash.config.router_self_proxy='1'
# 25.12 实测修复①：OpenClash 0.48 启动脚本找的内核文件名是 core/clash_meta，
# 而 feed 打包的内核名为 core/mihomo——不建链接则"Core not Detected"→尝试联网
# 下载内核→境外不可达→主开关被自动回写 0，表现为"内核下载失败后自启即关"
[ -f /etc/openclash/core/mihomo ] && [ ! -e /etc/openclash/core/clash_meta ] && \
	ln -sf /etc/openclash/core/mihomo /etc/openclash/core/clash_meta
# 25.12 实测修复②：LAN 为 DHCP 客户端（无静态 ipaddr）时，OpenClash 的 LAN IP
# 探测链在"pipeline 空值仍成功"处短路，报"LAN IP Address Get Error"拒绝启动；
# 显式指定接口名走 ip address show 分支
uci set openclash.config.lan_interface_name='br-lan'
# 25.12 实测修复③：LAN 是 DHCP 客户端，冷启动时 S99openclash 跑在 DHCP 拿到地址
# 之前，ip address show br-lan 为空 → 同样报 "LAN IP Address Get Error" 自关
# （修复②只解决探测逻辑，解决不了时序）。延迟 30 秒启动让 DHCP 客户端先完成
uci set openclash.config.delay_start='30'
uci commit openclash

# ============ ZeroTier 远程接入预置 ============
uci set zerotier.@zerotier[0].enabled='1'
# 删除包自带示例网络 earth——它会随服务启动自动加入陌生网络，纯属隐患
uci -q delete zerotier.earth
# ZT 虚拟网卡名是哈希随机值(如 ztonktpvpd)，无法预知，防火墙挂载只能用 zt* 通配；
# proto none 逻辑接口不管理 IP（ZT 守护进程自管），仅作为防火墙分区的载体
uci -q delete network.zerotier
uci set network.zerotier='interface'
uci set network.zerotier.proto='none'
uci set network.zerotier.ifname='zt*'
uci commit network
# 将 ZeroTier 设为独立防火墙区：input 放行（可访问路由器）、forward 与 lan
# 互通；zt→br-lan 方向的 NAT 由 /etc/firewall.zt-masq.nft 提供（见下）——
# 内网设备的默认网关是主路由而非本机，回程包不认识 ZT 网段，不 NAT 则
# "ping 通路由器却 ping 不通内网设备"（旁路由场景的固有不对称路由）
uci -q del_list firewall.@zone[0].network='zerotier'
uci -q delete firewall.zerotier
uci set firewall.zerotier='zone'
uci set firewall.zerotier.name='zerotier'
uci set firewall.zerotier.network='zerotier'
uci set firewall.zerotier.input='ACCEPT'
uci set firewall.zerotier.output='ACCEPT'
uci set firewall.zerotier.forward='ACCEPT'
uci set firewall.zt_fwd_lan='forwarding'
uci set firewall.zt_fwd_lan.src='zerotier'
uci set firewall.zt_fwd_lan.dest='lan'
uci set firewall.lan_fwd_zt='forwarding'
uci set firewall.lan_fwd_zt.src='lan'
uci set firewall.lan_fwd_zt.dest='zerotier'
# nft include（fw4 把文件内容插进 table inet fw4 内部，片段只写到 chain 层；
# 且必须写进 fw4 真正挂 hook 的 chain srcnat——自己新起链名是无 hook 死链）
uci -q delete firewall.zt_nat_include
uci set firewall.zt_nat_include='include'
uci set firewall.zt_nat_include.type='nft'
uci set firewall.zt_nat_include.path='/etc/firewall.zt-masq.nft'
uci commit firewall

exit 0
