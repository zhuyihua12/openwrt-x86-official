#!/bin/sh
# 首启配置: IPv6 全开(DHCP) + dnsmasq 全量转 mosdns + OpenClash 预置
# (uci-defaults 在 config_generate 之后、首次开机时执行一次)

# ============ WAN IPv6: DHCPv6 自动获取前缀/地址/DNS ============
if ! uci -q get network.wan6 >/dev/null 2>&1; then
	uci set network.wan6='interface'
	uci set network.wan6.proto='dhcpv6'
	uci set network.wan6.device='wan'
fi
uci set network.wan6.peerdns='1'
uci commit network

# 把 wan6 并入 wan 所在防火墙区（若 config_generate 未包含）
target=""; found=0; i=0
while uci -q get firewall.@zone[$i] >/dev/null 2>&1; do
	nets=$(uci -q get firewall.@zone[$i].network)
	case " $nets " in
	*" wan "*)
		target=$i
		case " $nets " in *" wan6 "*) found=1 ;; esac
		;;
	esac
	i=$((i+1))
done
if [ "$found" -eq 0 ] && [ -n "$target" ]; then
	uci add_list firewall.@zone[$target].network='wan6'
	uci commit firewall
fi

# ============ LAN IPv6: RA + DHCPv6 + NDP（客户端 v6 地址/网关/DNS 全自动） ============
uci set dhcp.lan.ra='server'
uci set dhcp.lan.dhcpv6='server'
uci set dhcp.lan.ndp='hybrid'
uci commit dhcp

# ============ dnsmasq: 全部 DNS 交给 mosdns(:5334)，不再读 resolv.conf ============
uci set dhcp.@dnsmasq[0].noresolv='1'
uci -q del_list dhcp.@dnsmasq[0].server='127.0.0.1#5334'
uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5334'
uci commit dhcp

# ============ OpenClash 预置（导入节点 -> 选节点 -> 保存应用 即可用） ============
uci set openclash.config.enable='1'
# LAN DNS 走 dnsmasq->mosdns 分流，不用 OpenClash 的全量 53 劫持（避免绕过 mosdns）
uci set openclash.config.enable_redirect_dns='0'
# IPv6 下代理域名统一不发 AAAA（fake-ip 走 v4 栈），防 IPv6 侧泄漏
uci set openclash.config.filter_aaaa_dns='1'
uci set openclash.config.ipv6_enable='1'
uci commit openclash

exit 0
